# ==============================================================================
# Miabeyefendi - Universal .env.example Template
# https://github.com/Miabeyefendi
# ------------------------------------------------------------------------------
# EN: Copy this file to ".env" and fill in your own values. NEVER commit the real
#     ".env" file - .gitignore already blocks it. Only this ".env.example" (with
#     placeholder values, no real secrets) belongs in version control.
# TR: Bu dosyayı ".env" olarak kopyalayın ve kendi değerlerinizi girin. Gerçek
#     ".env" dosyasını ASLA commit etmeyin - .gitignore zaten engeller. Yalnızca
#     bu ".env.example" (sahte değerlerle, gerçek sır içermeden) depoya girer.
# ------------------------------------------------------------------------------
# Rules of thumb:
#   - No spaces around "=":            KEY=value          (not KEY = value)
#   - Quote values with spaces:        KEY="my value"
#   - Keys are UPPER_SNAKE_CASE by convention.
#   - Rotate any secret that is ever accidentally committed or shared.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. General application settings
# ------------------------------------------------------------------------------
APP_NAME=my-project
APP_ENV=development            # development | staging | production
APP_DEBUG=true                # set to false in production
APP_PORT=3000
APP_URL=http://localhost:3000
TZ=Europe/Istanbul            # IANA timezone
LOG_LEVEL=debug               # debug | info | warn | error

# ------------------------------------------------------------------------------
# 2. Database
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql           # mysql | postgres | sqlite | mongodb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=change_me             # use a strong password; never the default
DB_NAME=my_database
# Alternatively, a single connection string (used by many ORMs):
# DATABASE_URL=postgresql://user:password@127.0.0.1:5432/my_database

# ------------------------------------------------------------------------------
# 3. Cache / queue (optional)
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 4. External API keys, tokens & webhooks
#    (delete the lines you do not use)
# ------------------------------------------------------------------------------
STEAM_API_KEY=your_steam_api_key_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
GITHUB_TOKEN=your_github_personal_access_token_here

# ------------------------------------------------------------------------------
# 5. Auth / session secrets
# ------------------------------------------------------------------------------
JWT_SECRET=generate_a_long_random_string_here
SESSION_SECRET=generate_another_long_random_string_here

# ------------------------------------------------------------------------------
# 6. Scraper / automation settings (project-specific)
# ------------------------------------------------------------------------------
TARGET_URL=https://example-target-site.com
MAX_RETRIES=5
REQUEST_TIMEOUT_MS=15000
DELAY_BETWEEN_REQUESTS_MS=2000
USER_AGENT=Mozilla/5.0 (compatible; MyBot/1.0; +https://github.com/Miabeyefendi)
# Optional proxy (leave empty to disable):
HTTP_PROXY=
HTTPS_PROXY=
